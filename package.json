{
  "name": "fleet-of-one-mcp-server",
  "version": "1.0.0",
  "description": "Proof-of-production MCP server for AI coding agents. Make \"done\" earn itself: verify_done runs your test command and diffs against git before a task counts as complete; check_repro confirms a bug reproduces before you fix it.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fleet-of-one-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "ai-agents",
    "proof-of-production",
    "developer-tools"
  ],
  "homepage": "https://fleetofone.dev",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
